{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for patients, professionals, and admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "professional", "admin"] },
        "phone": { "type": "string" },
        "cpf": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "rejected"] },
        "birthDate": { "type": "string" },
        "specialty": { "type": "string" },
        "crm": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "phone", "status"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Medical appointment request and records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "dateTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "scheduled", "completed", "canceled", "missed"] },
        "notes": { "type": "string" },
        "diagnosis": { "type": "string" },
        "prescription": { "type": "string" }
      },
      "required": ["id", "patientId", "doctorId", "dateTime", "status"]
    },
    "MedicalDocument": {
      "title": "Medical Document",
      "description": "Medical records, prescriptions, and exam files",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appointmentId": { "type": "string" },
        "patientId": { "type": "string" },
        "doctorId": { "type": "string" },
        "allowedViewerIds": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string", "enum": ["clinical_record", "prescription", "exam", "other"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "appointmentId", "patientId", "doctorId", "type", "title", "createdAt", "allowedViewerIds"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "isNew": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "message", "date", "isNew"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Medical appointments"
    },
    "medical_documents/{docId}": {
      "schema": "MedicalDocument",
      "description": "Medical records, prescriptions and exams"
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
